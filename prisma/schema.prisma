generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ACCOUNTANT
  ADMIN
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  PENDING_REVIEW
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  CARNET_IDENTIDAD
  NIT
  TITULO_PROPIEDAD
  CERTIFICADO_POSESION
  PODER_NOTARIADO
  ACTA_ASAMBLEA
  PERSONERIA_JURIDICA
  LICENCIA_FUNCIONAMIENTO
  REGISTRO_SANITARIO
  CERTIFICADO_USO_SUELO
  LICENCIA_AMBIENTAL
  REGISTRO_MUNICIPAL_AE
  CERT_SANITARIO_AGROPECUARIO
  CERT_INSPECCION_SEGURIDAD
  REGISTRO_PRODUCTOR_AGROP
  FORMULARIO_701
  FORMULARIO_280
  COMPROBANTE_PAGO
  CROQUIS_UBICACION
  FACTURA_LUZ
  OTRO
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
}

enum NotificationType {
  VENCIMIENTO
  VALIDACION
  PAGO
  OBSERVACION
  SISTEMA
}

// Zona RAU oficial según DS 24463
enum ZonaRAU {
  ALTIPLANO_PUNA
  VALLES
  SUBTROPICAL
  TROPICAL
}

// Subzonas oficiales RAU
enum SubzonaRAU {
  // Altiplano y Puna
  NORTE_RIBERANA_TITICACA
  NORTE_CON_TITICACA
  NORTE_SIN_TITICACA
  CENTRAL_CON_POOPO
  CENTRAL_SIN_POOPO
  SUR_SEMIDESERTICA
  SUR_ANDINA_PUNA
  // Valles
  VALLES_ABT_CBB_RIEGO
  VALLES_ABT_CBB_SECANO
  VALLES_ABT_CBB_VITICOLA
  OTROS_VALLES_RIEGO
  OTROS_VALLES_SECANO
  OTROS_VALLES_VITICOLA
  VALLES_CERR_SERRANIAS
  VALLES_CERR_OTROS_RIEGO
  VALLES_CERR_OTROS_SECANO
  VALLES_CERR_OTROS_VITICOLA
  CABECERAS_VALLE_SECANO
  // Subtropical
  YUNGAS
  SANTA_CRUZ
  CHACO
  // Tropical
  BENI_PANDO_ITURRALDE
}

// Tipo de actividad RAU
enum TipoActividadRAU {
  AGRICOLA_OTROS  // Agrícola + Avicultura, Apicultura, Floricultura, Cunicultura, Piscicultura
  PECUARIA
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(OWNER)
  phone         String?
  address       String?
  ci            String?   @unique
  nit           String?   @unique
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]

  properties    Property[]        @relation("OwnerProperties")
  payments      Payment[]         @relation("OwnerPayments")
  ownerDocs     Document[]        @relation("OwnerDocuments")
  notifications Notification[]

  clients    OwnerAccountant[] @relation("AccountantClients")
  assignedTo OwnerAccountant[] @relation("OwnerAccountants")

  auditLogs AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OwnerAccountant {
  id           String   @id @default(cuid())
  ownerId      String
  accountantId String
  assignedAt   DateTime @default(now())
  isActive     Boolean  @default(true)

  owner      User @relation("OwnerAccountants", fields: [ownerId], references: [id])
  accountant User @relation("AccountantClients", fields: [accountantId], references: [id])

  @@unique([ownerId, accountantId])
}

model Property {
  id              String         @id @default(cuid())
  ownerId         String
  name            String
  location        String
  municipality    String
  department      String
  area            Float          // hectáreas totales
  zona            ZonaRAU
  subzona         SubzonaRAU
  tipoActividad   TipoActividadRAU
  produccion      String?        // Ej: "Soya", "Caña de azúcar", "Ganadería vacuna"
  status          PropertyStatus @default(ACTIVE)
  registrationNum String?        @unique
  tituloPropiedad String?        // N° de título de propiedad
  coordinates     String?
  description     String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  owner     User             @relation("OwnerProperties", fields: [ownerId], references: [id])
  rauCalcs  RauCalculation[]
  documents Document[]
  payments  Payment[]
}

model TributaryRate {
  id            String           @id @default(cuid())
  year          Int
  zona          ZonaRAU
  subzona       SubzonaRAU
  tipoActividad TipoActividadRAU
  ratePerHa     Float            // Bs/ha
  minHectareas  Float
  maxHectareas  Float
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  calculations RauCalculation[]

  @@unique([year, subzona, tipoActividad])
}

model RauCalculation {
  id           String        @id @default(cuid())
  propertyId   String
  rateId       String
  gestion      Int           // año fiscal
  hectareas    Float         // ha declaradas
  areaNoAprov  Float         @default(0) // Área no aprovechable (Form 701 campo)
  baseAmount   Float         // hectareas * ratePerHa
  totalAmount  Float         // total a pagar
  dueDate      DateTime      // 31 octubre de la gestión
  status       PaymentStatus @default(PENDING)
  esNoImponible Boolean      @default(false)
  notes        String?       @db.Text
  approvedBy   String?
  approvedAt   DateTime?
  formulario   String        @default("701 V.3")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  property Property      @relation(fields: [propertyId], references: [id])
  rate     TributaryRate @relation(fields: [rateId], references: [id])
  payments Payment[]
}

model Payment {
  id            String        @id @default(cuid())
  propertyId    String
  ownerId       String
  calculationId String?
  amount        Float
  currency      String        @default("BOB")
  status        PaymentStatus @default(PENDING)
  paymentDate   DateTime?
  dueDate       DateTime      // 31 octubre
  receiptNumber String?
  entidadPago   String?       // banco donde se pagó
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  property    Property        @relation(fields: [propertyId], references: [id])
  owner       User            @relation("OwnerPayments", fields: [ownerId], references: [id])
  calculation RauCalculation? @relation(fields: [calculationId], references: [id])
  documents   Document[]
}

model Document {
  id           String         @id @default(cuid())
  ownerId      String
  propertyId   String?
  paymentId    String?
  type         DocumentType
  name         String
  fileName     String
  fileUrl      String
  fileSize     Int
  mimeType     String
  status       DocumentStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  observations String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  owner    User      @relation("OwnerDocuments", fields: [ownerId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])
  payment  Payment?  @relation(fields: [paymentId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  category  String
  updatedAt DateTime @updatedAt
}
